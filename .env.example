# Production / deployment
# NODE_ENV=production
# TRUST_PROXY=1            # number of reverse proxies in front of the API (Railway = 1)
# COOKIE_SAMESITE=none     # only if client (Vercel) and API (Railway) are on different sites; forces secure cookies
